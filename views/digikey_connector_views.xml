<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- DIGIKEY CONNECTOR FORM -->
    <record id="view_digikey_connector_form" model="ir.ui.view">
        <field name="name">digikey.connector.form</field>
        <field name="model">digikey.connector</field>

        <field name="arch" type="xml">
            <form
                string="DigiKey Integration"
                create="false"
                delete="false"
            >

                <header>

                    <button
                        name="action_check_connection"
                        string="Bağlantı Çek"
                        type="object"
                        class="btn-primary"
                        icon="fa-plug"
                    />

                    <button
                        name="action_open_product_fetch"
                        string="Ürün Çek"
                        type="object"
                        class="btn-secondary"
                        icon="fa-download"
                    />

                </header>

                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>

                        <group string="DigiKey API">

                            <field name="environment"/>

                            <field
                                name="client_id"
                                password="True"
                            />

                            <field
                                name="client_secret"
                                password="True"
                            />

                        </group>

                        <group string="Connection">

                            <field
                                name="connection_status"
                                widget="badge"
                                decoration-success="connection_status == 'connected'"
                                decoration-danger="connection_status == 'error'"
                                decoration-muted="connection_status == 'not_connected'"
                            />

                            <field
                                name="last_connection_check"
                                readonly="1"
                            />

                            <field
                                name="connection_message"
                                readonly="1"
                            />

                        </group>

                    </group>

                </sheet>

            </form>
        </field>
    </record>


    <!-- SINGLE CONNECTOR RECORD -->
    <record id="digikey_connector_main" model="digikey.connector">
        <field name="name">DigiKey Integration</field>
    </record>


    <!-- ACTION -->
    <record id="action_digikey_connector" model="ir.actions.act_window">
        <field name="name">DigiKey Integration</field>
        <field name="res_model">digikey.connector</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="digikey_connector_main"/>
        <field name="view_id" ref="view_digikey_connector_form"/>
        <field name="target">current</field>
    </record>


    <!-- INVENTORY MENU -->
    <menuitem
        id="menu_digikey_connector"
        name="DigiKey Integration"
        parent="stock.menu_stock_root"
        action="action_digikey_connector"
        sequence="95"
        groups="stock.group_stock_manager"
    />

</odoo>